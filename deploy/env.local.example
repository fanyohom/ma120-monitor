# 复制为项目根目录 .env.local（已被 .gitignore 忽略，切勿提交真实值）
#   cp deploy/env.local.example .env.local
#
# 飞书机器人 webhook。未配置或失效时，每日任务会重试后以非零码退出，
# systemd timer / GitHub Actions 都会标记为失败。
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/REPLACE_ME

# 可选：死人开关（healthchecks.io / Uptime Kuma 等）。
# 只在全部卡片推送成功后 ping 一次；外部监控发现超过 N 小时没有 ping 即告警，
# 可覆盖「交易日探测连续误判、脚本根本没走到推送」这类静默故障。
# 留空则不启用。
HEALTHCHECK_URL=

# 可选：应用的可信 Origin 白名单，逗号分隔。
# 仅在反代终止 TLS 时需要（应用默认只认 http://Host）。
# MA120_TRUSTED_ORIGIN=https://your.domain
